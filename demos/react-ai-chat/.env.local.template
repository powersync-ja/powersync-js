# Copy this template: `cp .env.local.template .env.local`
# The values below point to the local Postgres and PowerSync Service that `pnpm local:up` starts.

# The app (src/). Vite only bundles VITE_ variables.
VITE_POWERSYNC_URL=http://127.0.0.1:8080

# How replies reach the app while they generate. The app and the backend both read it, hence the VITE_ prefix.
#   postgres  The backend writes the growing reply to Postgres every STREAM_FLUSH_INTERVAL_MS. PowerSync syncs each write.
#   sse       The backend streams the reply to the app over Server-Sent Events and writes it to Postgres once, at the end.
# Changing it restarts the app and the backend while `pnpm dev` runs.
VITE_STREAM_MODE=postgres

# Reveal reply text at a steady pace. Set to false to show it in the steps it arrives in.
VITE_SMOOTH_TEXT=true

# The backend API (server/). Vite doesn't bundle these, so they never reach the browser.
# Which model writes the replies, as provider/model (see server/model.ts for the providers).
AI_MODEL=google/gemini-flash-lite-latest
# Free API key, no credit card: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# For AI_MODEL=anthropic/claude-opus-5-5
# ANTHROPIC_API_KEY=
# For AI_MODEL=openai/<model>
# OPENAI_API_KEY=
# Without an API key for the chosen provider, the backend streams a simulated reply.

DATABASE_URL=postgresql://postgres:changeme@127.0.0.1:5432/postgres
# Signs the tokens the backend issues. Must match the key in powersync/service.yaml. For local development only.
JWT_SECRET=PuPCx7PnBb2PqeMJCbjmudLDl4QICVw_C-2AkB3apqk

# Postgres mode: how often the backend writes the growing reply to Postgres. Each write syncs to clients as one update.
STREAM_FLUSH_INTERVAL_MS=100
# Both modes: send each reply at a steady pace of up to STREAM_CHARS_PER_SECOND, even when the model sends text in
# bursts. Replies finish a little after the model does. Set STREAM_THROTTLE=false to send text as soon as it arrives.
STREAM_THROTTLE=true
STREAM_CHARS_PER_SECOND=100
