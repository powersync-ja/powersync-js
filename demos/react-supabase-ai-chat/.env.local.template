# Copy this template: `cp .env.local.template .env.local`
# Values below point to local Supabase + local PowerSync.
# The anon key is the well-known default for all local Supabase instances.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
VITE_POWERSYNC_URL=http://127.0.0.1:8080

# AI worker (worker/). Vite only bundles VITE_ variables, so these never reach the browser.
# The model replies come from, as provider/model (see worker/model.ts for the providers).
AI_MODEL=google/gemini-flash-lite-latest
# Free API key, no credit card: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# For AI_MODEL=anthropic/claude-opus-5-5
# ANTHROPIC_API_KEY=
# For AI_MODEL=openai/<model>
# OPENAI_API_KEY=
# Without an API key for the chosen provider, the worker streams a simulated reply.

# How replies reach the app while they generate. The app and the worker both read it, hence the VITE_ prefix.
#   postgres  The worker writes the growing reply to Postgres every STREAM_FLUSH_INTERVAL_MS. PowerSync syncs each write.
#   sse       The worker streams the reply to the app over Server-Sent Events and writes it to Postgres once, at the end.
# Changing it restarts the app and the worker while `pnpm dev` runs.
VITE_STREAM_MODE=postgres

# Reveal reply text at a steady pace. Set to false to show it in the steps it arrives in.
VITE_SMOOTH_TEXT=true

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Postgres mode: how often the worker writes the growing reply to Postgres. Each write syncs to clients as one update.
STREAM_FLUSH_INTERVAL_MS=100
