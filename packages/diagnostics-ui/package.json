{
  "name": "@powersync/diagnostics-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Host-neutral Vue UI for PowerSync live-attach diagnostics, driven by the Diagnostics Port.",
  "author": "PowerSync",
  "license": "Apache-2.0",
  "homepage": "https://docs.powersync.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/powersync-ja/powersync-js.git"
  },
  "bugs": {
    "url": "https://github.com/powersync-ja/powersync-js/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm clean && vite build && pnpm build:css && pnpm build:types && pnpm build:standalone",
    "build:css": "tailwindcss -i ./src/style.css -o ./dist/style.css",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "build:standalone": "vite build --config vite.standalone.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "clean": "rm -rf dist"
  },
  "files": [
    "src",
    "dist"
  ],
  "dependencies": {
    "@nanostores/vue": "^1.1.0",
    "@powersync/diagnostics-core": "workspace:*",
    "@tanstack/vue-table": "^8.21.3",
    "@tanstack/vue-virtual": "^3.13.36",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "lucide-vue-next": "^1.0.0",
    "nanostores": "^1.5.2",
    "reka-ui": "^2.10.4",
    "shiki": "^3.23.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@iconify-json/carbon": "^1.2.26",
    "@powersync/common": "workspace:*",
    "@powersync/web": "workspace:*",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "tailwindcss": "^4.3.3",
    "unplugin-icons": "^23.0.1",
    "vite": "catalog:",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "vue": "^3.5.42"
  }
}
