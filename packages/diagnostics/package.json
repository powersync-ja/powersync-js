{
  "name": "@powersync/diagnostics",
  "version": "0.1.0",
  "description": "PowerSync DevTools: a devframe definition that serves live PowerSync diagnostics as a Vite DevTools dock, a node dev server, and MCP tools.",
  "type": "module",
  "main": "lib/src/index.js",
  "types": "lib/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/src/index.d.ts",
      "default": "./lib/src/index.js"
    },
    "./vite": {
      "types": "./lib/src/vite.d.ts",
      "default": "./lib/src/vite.js"
    },
    "./vite-static": {
      "types": "./lib/src/vite-static.d.ts",
      "default": "./lib/src/vite-static.js"
    },
    "./client": {
      "types": "./lib/src/client.d.ts",
      "default": "./lib/src/client.js"
    },
    "./page": {
      "types": "./lib/src/page.d.ts",
      "default": "./lib/src/page.js"
    },
    "./node": {
      "types": "./lib/src/node.d.ts",
      "default": "./lib/src/node.js"
    }
  },
  "author": "PowerSync",
  "license": "Apache-2.0",
  "files": [
    "lib",
    "src"
  ],
  "repository": "https://github.com/powersync-ja/powersync-js",
  "bugs": {
    "url": "https://github.com/powersync-ja/powersync-js/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "homepage": "https://docs.powersync.com",
  "scripts": {
    "build": "tsc -b",
    "build:prod": "tsc -b",
    "clean": "rm -rf lib tsconfig.tsbuildinfo",
    "watch": "tsc --build -w"
  },
  "peerDependencies": {
    "@powersync/common": "workspace:^2.3.0",
    "@powersync/web": "workspace:^2.2.0",
    "@vitejs/devtools-kit": ">=0.7.5",
    "vite": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@powersync/common": {
      "optional": true
    },
    "@powersync/web": {
      "optional": true
    },
    "@vitejs/devtools-kit": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@devframes/agentic": "1.0.0",
    "@powersync/diagnostics-core": "workspace:*",
    "@powersync/diagnostics-ui": "workspace:*",
    "devframe": "1.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@devframes/hub": "1.0.0",
    "@powersync/common": "workspace:*",
    "@powersync/web": "workspace:*",
    "@types/node": "catalog:",
    "@vitejs/devtools-kit": "^0.7.5",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
