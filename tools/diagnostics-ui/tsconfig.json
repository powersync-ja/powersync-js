{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    // `unplugin-icons` types import `vue` without depending on it; pin it to this package's copy so a
    // differently hoisted Vue does not split the component types.
    "paths": { "@/*": ["./src/*"], "vue": ["./node_modules/vue"] },
    "types": ["node"]
  },
  "include": ["src", "playground", "*.d.ts"]
}
